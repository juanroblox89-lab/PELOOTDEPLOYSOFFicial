rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas para imágenes de reseñas (abierto para carga pública con validación de tipo y tamaño)
    match /reviews/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024 // Máximo 5MB
        && request.resource.contentType.matches('image/.*');
    }
    
    // Reglas generales para el resto (productos, etc.)
    match /{allPaths=**} {
      // Lectura pública para que los clientes vean las fotos de productos
      allow read: if true;
      
      // Escritura restringida al administrador principal
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == 'juanroblox89@gmail.com'
      );
    }
  }
}
