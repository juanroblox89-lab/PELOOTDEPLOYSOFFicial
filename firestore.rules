rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función de ayuda para verificar si es administrador
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'juanroblox89@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Configuración global: Lectura pública, escritura solo administradores
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Productos: Lectura pública, escritura solo administradores
    match /products/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Categorías: Lectura pública, escritura solo administradores
    match /categories/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Perfiles de Usuario: Solo el dueño o un administrador
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email; // Validación de integridad
    }
    
    // Pedidos (Robust & Secure):
    match /orders/{orderId} {
      // Crear pedido: Permitido para cualquier usuario (autenticado o invitado) con campos de pedido válidos
      allow create: if request.resource.data.total is number
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt != null;

      // Leer pedido: Permitido si está autenticado (dueño o admin) o si es un invitado que conoce su userId
      allow read: if (request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()))
        || (resource.data.isGuest == true && request.auth == null);

      // Actualizar pedido: Administradores, cancelación por el creador, o actualización de paymentUrl por el creador
      allow update: if isAdmin() || (
        (
          (request.auth != null && resource.data.userId == request.auth.uid) ||
          (resource.data.isGuest == true && resource.data.userId.matches('^guest_.*'))
        ) && (
          // Cancelación de pedido pendiente
          (request.resource.data.status == 'cancelled' && resource.data.status == 'pending') ||
          // Agregar enlace de pago Mercado Pago
          (request.resource.data.paymentUrl is string)
        )
      );

      // Eliminar pedido: Prohibido para usuarios comunes (solo administradores)
      allow delete: if isAdmin();
    }

    // Carrito en la Nube: Sincronización privada por UID
    match /carts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Reseñas de Productos: Lectura pública, creación abierta con validación, modificación/borrado admin
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.productId is string
        && request.resource.data.userName is string;
      allow update, delete: if isAdmin();
    }

    // Colección de Administradores (Opcional, para control extra)
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Solo vía consola de Firebase
    }
  }
}
